local function fill_layer(self, layer, offset, size, count_on_layer, dim_layer)
	local lay = 0
	if dim_layer and dim_layer > 0 then lay = dim_layer - 4 end

	for i = 0, size - 1 do
		for j = 0, size - 1 do
			if layer[j + size * i + 1] == 1 then -- Lua индексация с 1
				local pos = vmath.vector3(
				j * self.cef - (self.cef / 2 * (size - 1)),
				i * self.cef - (self.cef / 2 * (size - 1)) + offset,
				-offset -- используем Z для глубины слоя
			)

			-- Создание плитки через фабрику
			local tile_url = factory.create("#tile_factory", pos)

			-- Передаем данные в скрипт плитки
			msg.post(tile_url, "init_tile", {
				type = self.generated_types[count_on_layer + 1],
				grid_x = j,
				grid_y = i
			})

			count_on_layer = count_on_layer + 1
		end
	end
end
return count_on_layer
end

function init(self)
self.cef = 64 -- Замени на свои Constants
self.generated_types = {1, 2, 1, 3} -- пример данных
end

function on_message(self, message_id, message, sender)
if message_id == hash("init_field") then
	local data = message.level_data
	local count = 0

	-- Вызов слоев (аналог Unity)
	count = fill_layer(self, data.LayerA, 0, 8, count)
	count = fill_layer(self, data.LayerB, 0.0175, 8, count)
	-- ... остальные слои
end
end