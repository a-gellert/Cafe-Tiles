[bootstrap]
main_collection = /main/main.collectionc
render = /main/render/game.renderc

[script]
shared_state = 1

[display]
width = 540
height = 960
high_dpi = 1

[render]
clear_color_red = 0.992
clear_color_green = 0.894
clear_color_blue = 0.918
clear_color_alpha = 1.0

[html5]
scale_mode = stretch
wasm_streaming = 1
show_fullscreen_button = 0
show_made_with_defold = 0
cssfile = /main/html5/pastel.css

[project]
title = Cafe Tiles
version = 1.0.0
dependencies#0 = https://github.com/defold/extension-poki-sdk/archive/refs/tags/4.1.0.zip

[native_extension]
app_manifest = /main/game.appmanifest

[input]
game_binding = /input/game.input_bindingc

[gui]
max_animation_count = 2048

[cafe]
autoplay = 0
fresh = 0
start_level = 0
more_games_url = https://poki.com/
debug_coins = 0
debug_popup = 
