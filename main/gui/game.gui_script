-- App controller: screens, level flow, popups, Poki events and input.
-- Game logic lives in main/modules/*, views in main/gui/*_view.lua and popups.lua.
local ui = require "main.gui.ui"
local game_view = require "main.gui.game_view"
local menu_view = require "main.gui.menu_view"
local popups = require "main.gui.popups"
local layout = require "main.modules.layout"
local session = require "main.modules.session"
local progress = require "main.modules.progress"
local poki = require "main.modules.poki"
local audio = require "main.modules.audio"
local i18n = require "main.modules.i18n"
local config = require "main.modules.config"
local missions = require "main.modules.missions"

local TOUCH = hash("touch")
local BACK = hash("back")
local UNDO = hash("undo")

local AUTO_STEP = 0.32
-- page-session minutes reported to Poki analytics (where do first sessions end?)
local TIME_MARKS = { 1, 2, 3, 4, 5, 7, 10, 15, 20, 30 }

local app = {}

local function log(...)
	if app.autoplay then print("[cafe]", ...) end
end

-- ---------------------------------------------------------------- screens

function app.rebuild()
	ui.gen = ui.gen + 1
	ui.buttons = {}
	app.pressed = nil
	if app.screen_layer then gui.delete_node(app.screen_layer) end
	if app.popup_layer then gui.delete_node(app.popup_layer) end
	app.screen_layer = ui.pane(nil, 0, 0)
	app.popup_layer = ui.pane(nil, 0, 0)
	ui.layer = "screen"
	if app.screen == "game" then
		game_view.build(app, app.screen_layer)
	else
		menu_view.build(app, app.screen_layer)
	end
	if app.popup then
		ui.layer = "popup"
		popups.build(app, app.popup)
		ui.layer = "screen"
	end
end

local function update_size()
	local w, h = window.get_size()
	if w == app.win_w and h == app.win_h then return false end
	app.win_w, app.win_h = w, h
	app.vw, app.vh, app.orient = layout.virtual_size(w, h)
	return true
end

-- parent: popup to return to when this one is dismissed (decor / chest / tasks over the win popup)
function app.open_popup(kind, data, parent)
	if app.popup then app.close_popup() end
	app.popup = { kind = kind, data = data, parent = parent }
	ui.layer = "popup"
	popups.build(app, app.popup)
	ui.layer = "screen"
end

function app.close_popup()
	if app.popup_root then gui.delete_node(app.popup_root) end
	ui.popup_gen = ui.popup_gen + 1
	app.popup_root = nil
	app.popup = nil
	app.pressed = nil
	ui.remove_buttons("popup")
end

local function refresh_popup()
	if app.popup then app.open_popup(app.popup.kind, app.popup.data, app.popup.parent) end
end

function app.open_child(kind, data)
	app.open_popup(kind, data, app.popup)
end

-- closes the popup and goes back to the one it was opened from
function app.dismiss()
	local parent = app.popup and app.popup.parent
	app.close_popup()
	if parent then
		app.open_popup(parent.kind, parent.data, parent.parent)
	elseif app.screen == "menu" then
		app.rebuild()
	end
end

-- the reward is rolled here, not in the popup builder: a rebuild must not open the chest twice
function app.open_chest()
	local reward = progress.open_star_chest()
	if reward then app.open_child("chest", reward) end
end

-- session gift (minutes of play): from the HUD, the menu or the win popup
function app.open_gift()
	local reward = progress.claim_gift()
	if not reward then return end
	poki.measure("gift", progress.gifts_taken, "claim")
	if app.popup then
		app.open_child("chest", reward)
	else
		if app.screen == "game" then poki.gameplay_stop() end
		app.open_popup("chest", reward)
	end
	if app.screen == "game" then game_view.refresh_gift() end
end

function app.continue_cost()
	return config.CONTINUE_COST_BASE + config.CONTINUE_COST_PER_LEVEL * (app.session and app.session.level or 1)
end

function app.show_menu()
	if app.popup and app.popup.kind == "jam" then progress.reset_streak() end
	poki.gameplay_stop()
	app.screen = "menu"
	app.session = nil
	app.popup = nil
	app.rebuild()
end

function app.start_level(level, skip_break)
	local function go()
		app.announced = {}
		missions.ensure(progress.data.missions, level)
		app.session = session.new(level, {
			mult = progress.coin_mult(),
			streak = progress.data.streak or 0,
		})
		app.screen = "game"
		app.popup = nil
		app.rebuild()
		game_view.intro()
		poki.measure("level", level, "start")
		log("level", level, "start, tiles", app.session.total, "streak", progress.data.streak or 0)
	end
	if skip_break then go() else poki.commercial_break(level, go) end
end

function app.play()
	app.start_level(progress.data.level)
end

-- ---------------------------------------------------------------- level flow

function app.pause()
	if app.screen ~= "game" or app.popup or app.session.status ~= "play" then return end
	poki.gameplay_stop()
	app.open_popup("pause")
end

function app.resume()
	app.close_popup()
end

function app.restart()
	progress.reset_streak()
	poki.measure("level", app.session.level, "fail")
	app.start_level(app.session.level)
end

function app.retry()
	progress.reset_streak()
	poki.measure("level", app.session.level, "fail")
	app.start_level(app.session.level)
end

-- Not ui.after: a resize rebuild must not cancel the result popup.
-- A popup opened meanwhile (a gift from the HUD) only postpones fn, the level must not get stuck.
local function later(delay, s, status, fn)
	timer.delay(delay, false, function()
		if app.session ~= s or s.status ~= status or app.screen ~= "game" then return end
		if app.popup then later(0.3, s, status, fn) else fn() end
	end)
end

function app.on_won_soon()
	local s = app.session
	later(1.1, s, "won", function()
		local r = session.result(s)
		progress.finish_level(s.level, r.stars, r.coins)
		-- tasks start counting once the player knows the basics
		local rep = s.level >= config.REVEAL_LEVEL and missions.apply(progress.data.missions, s.level, r)
			or { rows = {}, coins = 0, boosters = {}, changed = false }
		progress.add_coins(rep.coins)
		for kind, n in pairs(rep.boosters) do
			progress.data.boosters[kind] = (progress.data.boosters[kind] or 0) + n
		end
		progress.save()
		r.missions = rep
		poki.gameplay_stop()
		poki.measure("level", s.level, "complete")
		audio.play("win")
		log("level", s.level, "won", "stars", r.stars, "coins", r.coins, "orders", r.dishes, "showcase", r.showcase, "chances", 2 - s.chances)
		app.open_popup("win", r)
	end)
end

function app.on_jam_soon()
	local s = app.session
	-- early levels: the chef makes room on the shelf, no popup (players learn without losing)
	if session.can_second_chance(s, "free") then
		later(0.45, s, "jam", function()
			session.second_chance(s, "free")
			poki.measure("level", s.level, "rescue")
			log("level", s.level, "free rescue")
			game_view.process()
			game_view.toast(i18n.get("RESCUE"), "icon_bolt", 2.6)
		end)
		return
	end
	later(0.7, app.session, "jam", function()
		poki.gameplay_stop()
		log("level", app.session.level, "jam", "chances left", app.session.chances)
		app.open_popup("jam")
	end)
end

-- after a win: the tasks screen first when the level finished a task (its reward is shown there)
local function finished_task(rep)
	for _, row in ipairs(rep.rows) do
		if row.done then return true end
	end
	return false
end

function app.next_level()
	local p = app.popup
	local rep = p and p.kind == "win" and p.data and p.data.missions
	if rep and finished_task(rep) and not rep.shown then
		rep.shown = true
		app.open_popup("missions", rep)
		return
	end
	app.start_level(progress.data.level)
end

-- in-game toast when the running level finishes a task
function app.mission_check()
	local s = app.session
	if not s or s.level < config.REVEAL_LEVEL then return end
	local done = missions.live_done(progress.data.missions, { served = s.served, food_done = s.food_done, vip_served = s.vip_served,
		gold_found = s.gold_found, showcase = s.showcase })
	for _, i in ipairs(done) do
		if not app.announced[i] then
			app.announced[i] = true
			audio.play("star")
			game_view.toast(i18n.get("MISSION_DONE"), "icon_tasks", 2)
		end
	end
end

function app.continue_coins()
	local s = app.session
	local cost = app.continue_cost()
	if progress.data.coins < cost or not session.can_second_chance(s, true) then
		audio.play("blocked")
		return
	end
	progress.data.coins = progress.data.coins - cost
	progress.save()
	poki.measure("button", "continue-coins", "interact")
	app.close_popup()
	session.second_chance(s, true)
	game_view.spend_coins(cost)
	game_view.process()
end

local function rewarded(size, placement, on_ok)
	poki.measure("rewarded", placement, "interact")
	poki.rewarded(size, function(ok)
		if ok then
			on_ok()
		elseif app.screen == "game" and not app.popup then
			game_view.toast(i18n.get("NO_AD"))
		end
	end)
end

function app.second_chance()
	rewarded("medium", "second-chance", function()
		app.close_popup()
		session.second_chance(app.session)
		game_view.process()
	end)
end

function app.double_coins()
	local r = app.popup and app.popup.data
	if not r or r.doubled then return end
	rewarded("medium", "double-coins", function()
		r.doubled = true
		progress.add_coins(r.coins)
		progress.save()
		audio.play("coin")
		refresh_popup()
	end)
end

function app.use_booster(kind)
	local s = app.session
	if not s or app.popup or s.level < config.BOOSTERS_MIN_LEVEL then return end
	local can = (kind == "undo" and session.can_undo(s)) or (kind == "shuffle" and session.can_shuffle(s))
		or (kind == "rush" and session.can_rush(s))
	if not can then
		audio.play("blocked")
		ui.shake(game_view.booster_node(kind), 10)
		return
	end
	local function apply()
		session[kind](s)
		audio.play("booster")
		game_view.process()
		game_view.refresh_boosters()
		poki.gameplay_start()
	end
	local count = progress.data.boosters[kind] or 0
	if count > 0 then
		progress.data.boosters[kind] = count - 1
		progress.save()
		apply()
	else
		rewarded("small", "booster-" .. kind, apply)
	end
end

-- ---------------------------------------------------------------- menu actions

-- the decor popup reveals the purchase in its cafe preview, then shows a cafe level reward
function app.buy_decor(id)
	local ok, levelup = progress.buy_decor(id)
	if not ok then
		audio.play("blocked")
		return
	end
	poki.measure("cosmetic", id, "unlock-" .. (progress.data.decor[id] or 0))
	if levelup then poki.measure("cosmetic", "cafe-level", "unlock-" .. levelup.cafe_level) end
	audio.play("gift")
	local p = app.popup
	if p and p.kind == "decor" then
		p.data = p.data or {}
		p.data.just, p.data.levelup = id, levelup
	end
	-- the menu cafe (or the game strip) behind the popup changes too
	app.rebuild()
end

function app.set_audio(sound_on, music_on)
	progress.data.sound = sound_on
	progress.data.music = music_on
	progress.save()
	audio.set(sound_on, music_on)
	refresh_popup()
end

function app.next_language()
	i18n.set(i18n.next_language())
	progress.data.lang = i18n.get_language()
	progress.save()
	app.rebuild()
end

function app.more_games(url)
	poki.measure("button", "more-games", "interact")
	poki.open_link(url)
end

-- ---------------------------------------------------------------- autoplay (smoke tests)

local function autoplay_step()
	if poki.is_ad_active() then return end
	if app.popup then
		-- linger on popups so smoke-test screenshots can catch them
		app.popup_wait = (app.popup_wait or 0) + AUTO_STEP
		if app.popup_wait < 1.6 then return end
		app.popup_wait = 0
		local kind = app.popup.kind
		if kind == "win" or kind == "missions" then
			app.next_level()
		elseif kind == "jam" then
			if session.can_second_chance(app.session) then app.second_chance() else app.retry() end
		elseif kind == "chest" then
			app.dismiss()
		else
			app.close_popup()
		end
	elseif app.screen == "menu" then
		app.play()
	elseif progress.gift_ready() and app.session and app.session.status == "play" then
		app.open_gift()
	elseif app.session and app.session.status == "play" then
		local id = session.suggest(app.session)
		if id and game_view.tap_tile(id) then poki.gameplay_start() end
	end
end

-- ---------------------------------------------------------------- lifecycle

function init(self)
	msg.post(".", "acquire_input_focus")
	math.randomseed(os.time())
	progress.load(sys.get_config_int("cafe.fresh", 0) == 1)
	local start = sys.get_config_int("cafe.start_level", 0)
	if start > 0 then progress.data.level = start end
	if sys.get_config_int("cafe.debug_coins", 0) > 0 then progress.data.coins = sys.get_config_int("cafe.debug_coins", 0) end
	i18n.set(progress.data.lang ~= "" and progress.data.lang or i18n.detect())
	audio.set(progress.data.sound, progress.data.music)
	app.autoplay = sys.get_config_int("cafe.autoplay", 0) == 1
	app.auto_t = 0
	app.dw = sys.get_config_int("display.width", 540)
	app.dh = sys.get_config_int("display.height", 960)
	update_size()
	app.resize_t = nil
	-- straight into gameplay (Poki: no menus before playing); the cafe menu is one tap away
	app.start_level(progress.data.level, true)
	app.time_mark = 1
	-- visual QA: open a screen or popup right away
	-- (cafe.debug_popup = menu | win | jam | pause | decor | settings | gift | levelup)
	local dp = sys.get_config_string("cafe.debug_popup", "")
	if dp ~= "" then
		if dp == "menu" or dp == "decor" or dp == "settings" or dp == "levelup" then app.show_menu() end
		if dp == "jam" then app.session.status = "jam" end
		if dp == "menu" then
			-- the menu itself
		elseif dp == "levelup" then
			app.open_popup("chest", { coins = 120, booster = "shuffle", cafe_level = 3 })
		elseif dp == "gift" then
			app.open_popup("chest", { coins = 25, booster = "rush", gift = true })
		else
			app.open_popup(dp, dp == "win" and { stars = 3, coins = 128, earned = 92, bonus = 36, showcase = 2, dishes = 10, served = 9, streak = 2 } or nil)
		end
	end
end

function update(self, dt)
	app.page_time = (app.page_time or 0) + dt
	local mark = TIME_MARKS[app.time_mark or 1]
	if mark and app.page_time >= mark * 60 then
		app.time_mark = (app.time_mark or 1) + 1
		poki.measure("playtime", mark, "minutes")
	end
	audio.update(dt)
	if update_size() then app.resize_t = 0.12 end
	if app.resize_t then
		app.resize_t = app.resize_t - dt
		if app.resize_t <= 0 then
			app.resize_t = nil
			app.rebuild()
		end
	end
	if poki.is_ad_active() then return end
	if app.screen == "game" and app.session and not app.popup then
		-- the gift track counts real level play only
		if app.session.running and app.session.status == "play" then progress.play_time = progress.play_time + dt end
		session.update(app.session, dt)
		if #app.session.events > 0 then game_view.process() end
		game_view.update(dt)
	end
	if app.autoplay then
		app.auto_t = app.auto_t + dt
		if app.auto_t >= AUTO_STEP then
			app.auto_t = 0
			autoplay_step()
		end
	end
end

local function to_virtual(action)
	return action.x / app.dw * app.vw, action.y / app.dh * app.vh
end

function on_input(self, action_id, action)
	if poki.is_ad_active() then return true end
	if action_id == TOUCH then
		local x, y = to_virtual(action)
		local layer = app.popup and "popup" or "screen"
		if action.pressed then
			local b = ui.find_button(x, y, layer)
			if b then
				app.pressed = b
				ui.press(b)
			elseif app.screen == "game" and not app.popup and app.session then
				if game_view.tap(x, y) then poki.gameplay_start() end
			end
		elseif action.released and app.pressed then
			local b = app.pressed
			app.pressed = nil
			ui.release(b, ui.find_button(x, y, layer) == b)
		end
		return true
	elseif action_id == BACK and action.pressed then
		if app.popup and app.popup.kind == "pause" then
			app.resume()
		elseif app.popup and (app.popup.kind == "settings" or app.popup.kind == "decor"
			or (app.popup.kind == "missions" and not app.popup.data)) then
			app.dismiss()
		else
			app.pause()
		end
	elseif action_id == UNDO and action.pressed then
		app.use_booster("undo")
	end
end
