# Engine features left out of the HTML5 build (smaller wasm, see docs/KNOWLEDGE_BASE.md):
# physics 2D/3D, rig + model, particle FX, tilemaps, video recording, profiler, live update,
# image and types script modules, Basis texture transcoder, rich text.
# The game uses GUI, sound (WAV + Ogg Vorbis), input and fonts only.
platforms:
  wasm-web:
    context:
      excludeLibs: [physics, LinearMath, BulletDynamics, BulletCollision, script_bullet3d, box2d_defold, script_box2d_defold, gamesys_model, gamesys_rig, rig, gamesys_particle, particle, record, vpx, profile, profilerext, profiler_remotery, profiler_js, liveupdate, image, graphics_transcoder_basisu, basis_transcoder, font_richtext]
      excludeSymbols: [ScriptBullet3DExt, ScriptBox2DExt, ScriptModelExt, ResourceTypeParticleFX, ComponentTypeParticleFX, ScriptLibParticleFX, ResourceTypeTileMap, ComponentTypeTileMap, ScriptLibTileMap, ProfilerBasic, ProfilerRemotery, ProfilerJS, ScriptImageExt, ScriptTypesExt]
      symbols: []
      libs: [physics_null, gamesys_rig_null, gamesys_model_null, rig_null, particle_null, record_null, profile_null, profilerext_null, liveupdate_null, image_null, graphics_transcoder_null, font_richtext_null]
  wasm_pthread-web:
    context:
      excludeLibs: [physics, LinearMath, BulletDynamics, BulletCollision, script_bullet3d, box2d_defold, script_box2d_defold, gamesys_model, gamesys_rig, rig, gamesys_particle, particle, record, vpx, profile, profilerext, profiler_remotery, profiler_js, liveupdate, image, graphics_transcoder_basisu, basis_transcoder, font_richtext]
      excludeSymbols: [ScriptBullet3DExt, ScriptBox2DExt, ScriptModelExt, ResourceTypeParticleFX, ComponentTypeParticleFX, ScriptLibParticleFX, ResourceTypeTileMap, ComponentTypeTileMap, ScriptLibTileMap, ProfilerBasic, ProfilerRemotery, ProfilerJS, ScriptImageExt, ScriptTypesExt]
      symbols: []
      libs: [physics_null, gamesys_rig_null, gamesys_model_null, rig_null, particle_null, record_null, profile_null, profilerext_null, liveupdate_null, image_null, graphics_transcoder_null, font_richtext_null]
